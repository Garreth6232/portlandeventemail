<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ from_name }}</title>
<!--[if mso]><style>td, a, span, div { font-family: Arial, sans-serif !important; }</style><![endif]-->
</head>
{% set sans = "-apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif" %}
{% set serif = "Georgia, 'Times New Roman', Times, serif" %}
<body style="margin:0; padding:0; background:#ffffff; -webkit-text-size-adjust:100%;">
<div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">{{ preheader }}&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;">
<tr><td align="center" style="padding:36px 20px 40px;">

<!--[if mso]><table role="presentation" width="560" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; max-width:560px; margin:0 auto;">

{% if banners.header %}
  <tr>
    <td style="padding-bottom:14px;">
      <img src="{{ banners.header.src }}" width="{{ banner_width }}" alt="{{ banners.header.alt }}" style="display:block; width:100%; max-width:{{ banner_width }}px; height:auto; border:0; font-family:{{ serif }}; font-size:24px; color:#1b1b1b;">
    </td>
  </tr>
{% else %}
  <tr>
    <td style="font-family:{{ serif }}; font-size:28px; line-height:1.2; color:#1b1b1b; padding-bottom:4px;">{{ from_name }}</td>
  </tr>
{% endif %}
  <tr>
    <td style="font-family:{{ sans }}; font-size:14px; line-height:1.4; color:#6b6b6b; padding-bottom:20px; border-bottom:1px solid #1b1b1b;">{{ date_line }}</td>
  </tr>

{% if not sections %}
  <tr>
    <td style="font-family:{{ sans }}; font-size:15px; line-height:1.6; color:#3a3a3a; padding-top:28px;">Nothing new on the calendar. Back tomorrow.</td>
  </tr>
{% endif %}

{% for section in sections %}
  <tr>
    <td style="padding-top:32px; padding-bottom:6px;">
      <span style="font-family:{{ serif }}; font-size:20px; line-height:1.3; color:#1b1b1b;">{{ section.title }}</span>
      {% if section.span %}<span style="font-family:{{ sans }}; font-size:13px; color:#8a8a8a;">&nbsp;&nbsp;{{ section.span }}</span>{% endif %}
    </td>
  </tr>
  {% for row in section.rows %}
  <tr>
    <td style="border-top:1px solid #e7e5e0; padding:13px 0;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td width="84" valign="top" style="width:84px; padding-right:12px; font-family:{{ sans }}; font-size:13px; line-height:1.45; color:#1b1b1b;">
            {{ row.primary }}
            {% if row.secondary %}<br><span style="color:#8a8a8a;">{{ row.secondary }}</span>{% endif %}
          </td>
          <td valign="top" style="font-family:{{ sans }};">
            <a href="{{ row.url }}" style="font-size:15px; line-height:1.4; font-weight:600; color:#1b1b1b; text-decoration:none;">{{ row.name }}</a>
            <div style="font-size:13px; line-height:1.5; color:#6b6b6b; padding-top:2px;">{{ row.meta }}</div>
            {% if row.more %}<div style="font-size:13px; line-height:1.5; color:#8a8a8a;">{{ row.more }}</div>{% endif %}
          </td>
        </tr>
      </table>
    </td>
  </tr>
  {% endfor %}
  {% if section.overflow %}
  <tr>
    <td style="border-top:1px solid #e7e5e0; padding-top:11px; font-family:{{ sans }}; font-size:13px; color:#8a8a8a;">{{ section.overflow }}</td>
  </tr>
  {% endif %}
{% endfor %}

{% if banners.footer %}
  <tr>
    <td style="padding-top:40px;">
      <img src="{{ banners.footer.src }}" width="{{ banner_width }}" alt="{{ banners.footer.alt }}" style="display:block; width:100%; max-width:{{ banner_width }}px; height:auto; border:0; font-family:{{ sans }}; font-size:14px; color:#6b6b6b;">
    </td>
  </tr>
{% endif %}
  <tr>
    <td style="padding-top:{{ '20px' if banners.footer else '40px' }};">
      <div style="border-top:1px solid #e7e5e0; padding-top:16px; font-family:{{ sans }}; font-size:12px; line-height:1.6; color:#8a8a8a;">
        {% if sources %}Listings from {{ sources }}. {% endif %}Times and prices change, so check the link before you head out. Reply if you'd like off the list.
      </div>
    </td>
  </tr>

</table>
<!--[if mso]></td></tr></table><![endif]-->

</td></tr>
</table>
</body>
</html>
