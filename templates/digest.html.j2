<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ from_name }}</title>
<!--[if mso]><style>td, a, span, div { font-family: Arial, sans-serif !important; }</style><![endif]-->
</head>
{% set sans = "-apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif" %}
{% set serif = "Georgia, 'Times New Roman', Times, serif" %}
{% set ink = "#1b1b1b" %}
{% set muted = "#6b6b6b" %}
{% set faint = "#8a8a8a" %}
{% set rule = "#e7e5e0" %}
{% set accent = "#13795b" %}
{% set pick = "#b35c00" %}
{% set free = "#23733a" %}
{% set gutter = "28px" %}
<body style="margin:0; padding:0; background:#ffffff; -webkit-text-size-adjust:100%;">
<div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">{{ preheader }}&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;">
<tr><td align="center" style="padding:16px 0 40px;">

<!--[if mso]><table role="presentation" width="{{ width }}" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; max-width:{{ width }}px; margin:0 auto;">

{% if banners.header %}
  <tr>
    <td>
      <img src="{{ banners.header.src }}" width="{{ width }}" alt="{{ banners.header.alt }}" style="display:block; width:100%; max-width:{{ width }}px; height:auto; border:0; font-family:{{ serif }}; font-size:24px; color:{{ ink }};">
    </td>
  </tr>
{% else %}
  <tr>
    <td style="padding:20px {{ gutter }} 0; font-family:{{ serif }}; font-size:30px; line-height:1.2; color:{{ ink }};">{{ from_name }}</td>
  </tr>
{% endif %}

  <tr>
    <td style="padding:0 {{ gutter }};">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">

        <tr>
          <td style="padding:18px 0 16px; border-bottom:2px solid {{ ink }}; font-family:{{ sans }};">
            <div style="font-size:17px; line-height:1.3; font-weight:700; color:{{ ink }};">{{ date_line }}</div>
            {% if weather %}<div style="font-size:13px; line-height:1.45; color:{{ muted }}; padding-top:4px;">{% for part in weather.split(' · ') %}<span style="white-space:nowrap;">{{ part }}</span>{% if not loop.last %} &middot; {% endif %}{% endfor %}</div>{% endif %}
            {% if summary %}<div style="font-size:14px; line-height:1.4; color:{{ muted }}; padding-top:3px;">{{ summary|capitalize }}</div>{% endif %}
          </td>
        </tr>

{% if not sections %}
        <tr>
          <td style="font-family:{{ sans }}; font-size:16px; line-height:1.6; color:#3a3a3a; padding-top:28px;">Nothing new on the calendar. Back tomorrow.</td>
        </tr>
{% endif %}

{% for section in sections %}
        <tr>
          <td style="padding-top:36px; padding-bottom:8px;">
            <span style="font-family:{{ serif }}; font-size:25px; line-height:1.25; color:{{ accent }};">{{ section.title }}</span>
            {% if section.span %}<span style="font-family:{{ sans }}; font-size:14px; color:{{ faint }};">&nbsp;&nbsp;{{ section.span }}</span>{% endif %}
          </td>
        </tr>
  {% for row in section.rows %}
        <tr>
          <td style="border-top:1px solid {{ rule }}; padding:15px 0;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td width="92" valign="top" style="width:92px; padding-right:14px; font-family:{{ sans }}; font-size:14px; line-height:1.45; font-weight:600; color:{{ ink }};">
                  {{ row.primary }}
                  {% if row.secondary %}<br><span style="font-weight:400; color:{{ faint }};">{{ row.secondary }}</span>{% endif %}
                </td>
                <td valign="top" style="font-family:{{ sans }};">
                  {% if row.label or row.pick %}
                  <div style="font-size:11px; line-height:1.4; font-weight:700; letter-spacing:0.6px; text-transform:uppercase; padding-bottom:3px;">
                    {% if row.label %}<span style="color:{{ row.color }};">{{ row.label }}</span>{% endif %}
                    {% if row.label and row.pick %}<span style="color:{{ faint }};">&nbsp;&middot;&nbsp;</span>{% endif %}
                    {% if row.pick %}<span style="color:{{ pick }};">&#9733; Top pick</span>{% endif %}
                  </div>
                  {% endif %}
                  <a href="{{ row.url }}" style="font-size:17px; line-height:1.35; font-weight:700; color:{{ ink }}; text-decoration:none;">{{ row.name }}</a>
                  {% if row.venue or row.price %}
                  <div style="font-size:14px; line-height:1.5; color:{{ muted }}; padding-top:3px;">
                    {% if row.venue %}{{ row.venue }}{% endif %}
                    {% if row.venue and row.price %}&nbsp;&middot;&nbsp;{% endif %}
                    {% if row.price %}<span style="{% if row.free %}color:{{ free }}; font-weight:700;{% endif %}">{{ row.price }}</span>{% endif %}
                  </div>
                  {% endif %}
                  {% if row.more %}<div style="font-size:13px; line-height:1.5; color:{{ faint }}; font-style:italic; padding-top:1px;">{{ row.more }}</div>{% endif %}
                </td>
              </tr>
            </table>
          </td>
        </tr>
  {% endfor %}
  {% if section.overflow %}
        <tr>
          <td style="border-top:1px solid {{ rule }}; padding-top:12px; font-family:{{ sans }}; font-size:14px; color:{{ faint }};">{{ section.overflow }}</td>
        </tr>
  {% endif %}
{% endfor %}

      </table>
    </td>
  </tr>

{% if banners.footer %}
  <tr>
    <td style="padding-top:44px;">
      <img src="{{ banners.footer.src }}" width="{{ width }}" alt="{{ banners.footer.alt }}" style="display:block; width:100%; max-width:{{ width }}px; height:auto; border:0; font-family:{{ sans }}; font-size:14px; color:{{ muted }};">
    </td>
  </tr>
{% endif %}
  <tr>
    <td style="padding:{{ '20px' if banners.footer else '44px' }} {{ gutter }} 0;">
      <div style="border-top:1px solid {{ rule }}; padding-top:16px; font-family:{{ sans }}; font-size:12px; line-height:1.6; color:{{ faint }};">
        {% if sources %}Listings from {{ sources }}. {% endif %}Times and prices change, so check the link before you head out. Reply if you'd like off the list.
      </div>
    </td>
  </tr>

</table>
<!--[if mso]></td></tr></table><![endif]-->

</td></tr>
</table>
</body>
</html>
