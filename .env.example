# Copy to .env for local runs. The scheduled job reads these from
# repository secrets instead (Settings > Secrets and variables > Actions).

# Sending. Required for a real send, not for --dry-run.
# The Gmail account the email comes from, and an app password for it
# (Google Account > Security > 2-Step Verification > App passwords).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
FROM_NAME=Portland Events
RECIPIENTS=you@example.com,partner@example.com,friend@example.com,another@example.com

# Big-venue and club listings. Both optional; leave blank to skip that source.
# https://developer.ticketmaster.com  (Consumer Key)
TICKETMASTER_API_KEY=
# https://seatgeek.com/account/develop  (Client ID)
SEATGEEK_CLIENT_ID=
